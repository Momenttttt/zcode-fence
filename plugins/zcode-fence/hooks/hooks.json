{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|ApplyPatch",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/scripts/guard.js"],
            "timeoutMs": 5000,
            "statusMessage": "zcode-fence 检查中"
          }
        ]
      }
    ]
  }
}
